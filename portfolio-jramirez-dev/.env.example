# Endpoint del formulario de contacto en Formspree (https://formspree.io)
# Crear un form apuntando al correo personal y copiar aquí su endpoint.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/TU_FORM_ID

# Correo de contacto visible y enlace mailto (por defecto: jramirez.dev.net@gmail.com)
VITE_CONTACT_EMAIL=jramirez.dev.net@gmail.com

# Número de WhatsApp destino: solo dígitos con código de país (formato wa.me).
# En producción se define como variable del repo en GitHub Actions.
VITE_WHATSAPP=503XXXXXXXX

# Google Tag / Google Analytics 4 Measurement ID (ej: G-XXXXXXXXXX o AW-XXXXXXXXXX)
# Se define como variable en GitHub Actions (Settings -> Secrets and variables -> Actions -> Variables)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

